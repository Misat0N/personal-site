---
import HomePage from "../../components/HomePage.astro";
import { getProfile } from "../../content";
import type { Locale } from "../../content/types";
import { isLocale } from "../../i18n/config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublished } from "../../lib/cms/repository";
import { getCmsDb } from "../../lib/cms/runtime";

export const prerender = false;

if (!isLocale(Astro.params.lang)) return Astro.redirect("/", 302);
const locale = Astro.params.lang as Locale;
let content = getProfile(locale);
try {
  const db = getCmsDb();
  const published = db ? await getPublished(db, locale) : null;
  if (published) content = published.content;
} catch (error) {
  console.error(`CMS fallback for ${locale}`, error);
}
Astro.response.headers.set("Cache-Control", "public, max-age=60, stale-while-revalidate=300");
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  draft={content.draftMode}
  themeToLight={content.ui.themeToLight}
  themeToDark={content.ui.themeToDark}
>
  <HomePage locale={locale} content={content} />
</BaseLayout>
