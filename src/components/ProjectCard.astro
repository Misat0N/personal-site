---
import type { ResumeItem } from "../content/types";

interface Props {
  item: ResumeItem;
  number: number;
  highlightsLabel: string;
  tagsLabel: string;
}

const { item, number, highlightsLabel, tagsLabel } = Astro.props;
---

<article class="project-card reveal">
  <div class="project-card__topline">
    <span>{String(number).padStart(2, "0")}</span>
    <span>{item.kicker}</span>
  </div>
  {item.media && (
    <figure class="project-card__media">
      <a href={item.media.source.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.media.source.label} · ${item.title}`}>
        <img src={item.media.src} alt={item.media.alt} loading="lazy" decoding="async" />
      </a>
      <figcaption>
        <span>{item.media.caption}</span>
        <span class="project-card__media-links">
          <a href={item.media.source.href} target="_blank" rel="noopener noreferrer">{item.media.source.label} ↗</a>
          {item.media.license && <a href={item.media.license.href} target="_blank" rel="noopener noreferrer">{item.media.license.label} · unchanged ↗</a>}
        </span>
      </figcaption>
    </figure>
  )}
  <div class="project-card__identity">
    <h3>{item.title}</h3>
    {item.subtitle && <p>{item.subtitle}</p>}
    <div class="project-card__period">
      <span>{item.period}</span>
      {item.status && <i>{item.status}</i>}
    </div>
  </div>
  <div class="project-card__body">
    <p class="project-card__summary">{item.summary}</p>
    {item.highlights.length > 0 && (
      <div class="project-card__highlights">
        <span>{highlightsLabel}</span>
        <ul>
          {item.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>
    )}
    <div class="tag-list" aria-label={tagsLabel}>
      {item.tags.map((tag) => <span>{tag}</span>)}
    </div>
    {item.links && item.links.length > 0 && (
      <nav class="project-card__links" aria-label={`${item.title} links`}>
        {item.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}
      </nav>
    )}
  </div>
</article>
