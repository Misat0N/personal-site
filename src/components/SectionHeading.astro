---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { index, eyebrow, title, description } = Astro.props;
---

<header class="section-heading reveal">
  <div class="section-heading__meta">
    <span>{index}</span>
    <span>{eyebrow}</span>
  </div>
  <div class="section-heading__copy">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</header>
